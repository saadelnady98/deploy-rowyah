    "faq": {
      "title": "الاسئلة الشائعة ",
      "q1": {
        "question": "ما هي الخدمات التي تقدمها Ruwyah؟",
        "answer": "نقدم مجموعة متنوعة من الخدمات البرمجية، بما في ذلك تطوير المواقع، التطبيقات، حلول مخصصة، واستشارات تقنية."
      },
      "q2": {
        "question": "كيف يمكنني البدء في العمل معكم على مشروعي؟",
        "answer": "يمكنك التواصل معنا عبر نموذج 'تواصل معنا' وإرسال تفاصيل مشروعك، وسيتواصل فريقنا معك لمناقشة المتطلبات والخطوات القادمة."
      },
      "q3": {
        "question": "هل توفرون حلول برمجية مخصصة حسب احتياجات المشروع؟",
        "answer": "نعم، نقدم حلول برمجية مخصصة تلبي الاحتياجات الفريدة لكل مشروع بعد دراسة متطلباته بدقة."
      },
      "q4": {
        "question": "ما التقنيات التي تستخدمونها في تطوير المشاريع؟",
        "answer": "نستخدم أحدث التقنيات مثل React, Node.js, Python، مع تركيز خاص على اختيار الأنسب لكل مشروع."
      },
      "q5": {
        "question": "هل تقدمون خدمات الدعم والصيانة بعد إطلاق المشروع؟",
        "answer": "نقدم حزم دعم شاملة تشمل الصيانة الدورية، التحديثات الأمنية، والدعم الفني المستمر."
      }
    }
